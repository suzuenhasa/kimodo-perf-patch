+@lru_cache(maxsize=32)
+def _factorized_system(n, pos_weight, loop):
+    """Build and LU-factorize the ADMM system matrix for an ``n``-frame trajectory.
+
+    ``M = pos_weight * I + A^T A + stepsize * I`` depends only on ``n``, ``pos_weight``
+    and ``loop`` -- it holds no trajectory data -- so the factorization is memoized and
+    reused by every smoother of the same shape, across multigrid levels and across calls.
+
+    Args:
+        n: Number of frames.
+        pos_weight: Weight for position preservation.
+        loop: Whether the trajectory should loop.
+
+    Returns:
+        Tuple of the ADMM step size and the ``splu`` factorization of ``M``.
+    """
+    # Build acceleration matrix A
+    a_data = []
+    a_rows = []
+    a_cols = []
+
+    for i in range(1, n - 1):
+        scale = 1.0
+        a_data.extend([-scale, 2.0 * scale, -scale])
+        a_rows.extend([i, i, i])
+        a_cols.extend([i - 1, i, i + 1])
+
+    if loop:
+        # Add periodic accelerations
+        scale = 1.0
+        a_data.extend([-scale, 2.0 * scale, -scale])
+        a_rows.extend([0, 0, 0])
+        a_cols.extend([n - 1, 0, 1])
+
+        scale = 1.0
+        a_data.extend([-scale, 2.0 * scale, -scale])
+        a_rows.extend([n - 1, n - 1, n - 1])
+        a_cols.extend([n - 2, n - 1, 0])
+
+    A = sparse.csr_matrix((a_data, (a_rows, a_cols)), shape=(n, n))
+
+    # Build identity matrix
+    identity_matrix = sparse.eye(n)
+
+    # Build system matrix M
+    M = pos_weight * identity_matrix + A.T @ A
+
+    # Calculate ADMM step size
+    diag_max = max(abs(M.diagonal()))
+    admm_stepsize = 0.25 * np.sqrt(diag_max)
+
+    M = M + admm_stepsize * identity_matrix
+    return admm_stepsize, splu(M.tocsc())
+
+
