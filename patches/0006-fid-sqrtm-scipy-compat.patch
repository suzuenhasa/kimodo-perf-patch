+def _sqrtm(a):
+    """scipy.linalg.sqrtm across versions.
+
+    Before scipy 1.16 it accepted disp=False and returned (result, errest); newer versions
+    dropped both and return the matrix alone. Kimodo pins no scipy, so calling it the old
+    way raises TypeError and every FID metric fails.
+    """
+    r = linalg.sqrtm(a)
+    return r[0] if isinstance(r, tuple) else r
+
